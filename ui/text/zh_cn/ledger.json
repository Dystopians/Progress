{
  "schema_version": 1,
  "t": {
    "ld.title": "台账 · {name}（{alias}）",
    "ld.caliber.cash": "口径：本季结算账本中国库现金账户的逐笔变动（单位 U，另列内部记账原值 μU）；行号即引用码。",
    "ld.caliber.transaction": "口径：本季结算账本的全部双边交易行（每笔交易两行，借贷相抵）；主体与科目按记账编码解读。",
    "ld.caliber.debt": "口径：未偿债券逐批次（持有人、余额、票息、发行季、到期季），其后为未来八季的到期本金与票息（规则推断，逐批次计算）。",
    "ld.caliber.commit": "口径：已签合同的项目与政策预算承诺；末行为季末承诺总额（备忘，不是现金）。",
    "ld.caliber.project": "口径：项目实例逐行（状态、已付、合同总额、交付与施工进度、挂起原因）。",
    "ld.caliber.constraint": "口径：16 个地区部门单元本季的五项产出约束（同一产品口径），实际产出取最小值；「不约束」表示该项系数为 0。",
    "ld.caliber.command": "口径：命令缓冲的全部记录（只追加）：签发季、命令、参数、是否受理、拒绝码；推进标记单列。",
    "ld.caliber.labor": "口径：各地区劳动年龄人口按技能分档的就业人数 / 劳动力，末列为地区失业率（分母=劳动力）。",
    "ld.caliber.household": "口径：36 个群组的人口、本季可支配收入、住房支出、生活指数、信任与支持（季末）。",
    "ld.caliber.politics": "口径：36 个群组的人口、本季可支配收入、住房支出、生活指数、信任与支持（季末）。",
    "ld.caliber.service": "口径：各地区公共服务可用率、教师与医护人数、排队人数、本季实付运行费。",
    "ld.caliber.opex": "口径：各地区公共服务可用率、教师与医护人数、排队人数、本季实付运行费。",
    "ld.caliber.tax": "口径：本季个人所得税、企业利润税与其他收入的实收，征收能力与应收税款余额（季末）。",
    "ld.caliber.external": "口径：外部信用额度与已用额度（季末）、本季出口与进口；进行中的外生冲击只列类别，不披露抽样值。",
    "ld.caliber.value_added": "口径：16 个地区部门单元本季的名义增加值、基年价增加值、总产出与工资总额。",
    "ld.caliber.generic": "口径：本台账在首版没有专用视图。",
